# NEBULA configuration — copy to .env for local development.
#
# Precedence, lowest to highest: code defaults, config file, environment,
# command-line flags. Everything here has a default in code except the database
# URL, which is deliberately required: a service that silently connects to a
# default database is worse than one that refuses to start.
#
# .env is gitignored. Never commit real credentials.

# ---- environment -----------------------------------------------------------
# dev | staging | production.
# In production every NEBULA_DEV_* setting below becomes a startup FAILURE, text
# logs are refused, and a well-known database password is refused.
NEBULA_ENV=dev

# ---- database (required) ---------------------------------------------------
NEBULA_DATABASE_URL=postgres://nebula:nebula@127.0.0.1:5432/nebula?sslmode=disable

# Connection pool. Replica count times NEBULA_DATABASE_MAX_CONNS must stay below
# the server's max_connections; PgBouncer is the next step, not more replicas.
#NEBULA_DATABASE_MAX_CONNS=10
#NEBULA_DATABASE_MIN_CONNS=2
#NEBULA_DATABASE_MAX_CONN_LIFETIME=1h
#NEBULA_DATABASE_MAX_CONN_IDLE_TIME=30m
#NEBULA_DATABASE_CONNECT_TIMEOUT=10s

# Applied server-side to every session, so a runaway query cannot hold a
# connection indefinitely.
#NEBULA_DATABASE_STATEMENT_TIMEOUT=30s

# Refuse to serve when the schema is not the version this binary was built
# against. Leave this on.
#NEBULA_DATABASE_ASSERT_SCHEMA_VERSION=true

# ---- authentication (required for the control plane) -----------------------
# Mixed into every API key hash and held only in the application's memory, so a
# database dump alone does not yield verifiable hashes. Generate one with:
#   openssl rand -base64 32
# Required in production, and a missing one fails startup rather than every
# request. In dev, leaving it unset uses a well-known development pepper, which
# production refuses by name.
NEBULA_AUTH_KEY_PEPPER=

# How long a verified key stays cached in process. Until revocation is broadcast
# (Phase 6) this TTL is the entire revocation delay across replicas, which is why
# the default is short. The process that performs a revocation drops its own entry
# immediately.
#NEBULA_AUTH_KEY_CACHE_TTL=30s
#NEBULA_AUTH_KEY_CACHE_SIZE=4096

# ---- internal service authentication (gateway <-> control plane) ------------
# Signs X-Nebula-Auth-Context, the identity the gateway attaches to every call it
# makes to the control plane. Same value on both services; at least 32 bytes.
# Required by the gateway. `make run-*` uses a development value that production
# refuses by name.
#NEBULA_INTERNAL_AUTH_SECRET=
#NEBULA_INTERNAL_AUTH_MAX_AGE=10s   # replay window; seconds, not minutes

# ---- gateway (nebula-gateway only) -------------------------------------------
# The gateway has NO database access: leave NEBULA_DATABASE_URL unset for it, or
# it refuses to start. It needs the pepper (it verifies keys), the internal
# secret, and ideally Redis.
#NEBULA_REDIS_URL=redis://127.0.0.1:6379/0   # unset: per-replica limits, approximate
#NEBULA_GATEWAY_CONTROLPLANE_URL=http://127.0.0.1:8082
#NEBULA_GATEWAY_ROUTES_FILE=deploy/dev/routes.yaml   # static routes until Phase 6
#NEBULA_GATEWAY_DEFAULT_TIMEOUT=60s
#NEBULA_GATEWAY_MAX_TIMEOUT=10m
#NEBULA_GATEWAY_KEEPALIVE_INTERVAL=15s
#NEBULA_GATEWAY_STREAM_WRITE_TIMEOUT=10s    # a client that stops reading is cut off
#NEBULA_GATEWAY_LOCAL_KEY_CACHE_TTL=5s      # the cross-replica revocation delay
#NEBULA_GATEWAY_STALE_KEY_GRACE=5m          # keys keep working this long if the control plane is down

# Rate limits. Per key (unless its rate_limit_policy says otherwise) and per org.
#NEBULA_LIMITS_KEY_RPM=600
#NEBULA_LIMITS_KEY_TPM=200000
#NEBULA_LIMITS_KEY_CONCURRENCY=32
#NEBULA_LIMITS_ORG_RPM=6000
#NEBULA_LIMITS_ORG_TPM=2000000
#NEBULA_LIMITS_ORG_CONCURRENCY=256
#NEBULA_LIMITS_FALLBACK_FRACTION=0.5        # scale while Redis is down

# ---- logging ---------------------------------------------------------------
#NEBULA_LOG_LEVEL=info          # debug | info | warn | error
#NEBULA_LOG_FORMAT=json         # json | text; text is development only
#NEBULA_LOG_ADD_SOURCE=false    # file:line on every line; noisy in production

# ---- HTTP ------------------------------------------------------------------
#NEBULA_HTTP_ADDR=:8082
#NEBULA_HTTP_READ_HEADER_TIMEOUT=10s
#NEBULA_HTTP_READ_TIMEOUT=30s
#NEBULA_HTTP_WRITE_TIMEOUT=60s
#NEBULA_HTTP_IDLE_TIMEOUT=120s

# Must be shorter than the pod's terminationGracePeriodSeconds.
#NEBULA_HTTP_SHUTDOWN_GRACE=25s

# Pause between failing readiness and refusing traffic, so EndpointSlice
# propagation completes first. This is the fix for 503s during a rolling deploy.
#NEBULA_HTTP_DRAIN_DELAY=5s

#NEBULA_HTTP_MAX_HEADER_BYTES=1048576
#NEBULA_HTTP_MAX_BODY_BYTES=10485760

# ---- development only ------------------------------------------------------
# Each of these is rejected at startup when NEBULA_ENV=production.
# Seeds a development org, owner and full-scope API key, idempotently, and logs
# the plaintext key once at startup. That log line is the reason this is refused
# in production twice over: by configuration validation and by the seeder itself.
#NEBULA_DEV_SEED=false
# Allows registering mock-format artifacts against the mock runtime. Without it
# the registry refuses them, so a mock cannot reach a deployment by accident.
#NEBULA_DEV_MOCK_RUNTIME=false
#NEBULA_DEV_DEBUG_ENDPOINTS=false # expose /debug/pprof

# ---- config file -----------------------------------------------------------
# Optional YAML file; the environment overrides it, flags override both.
#NEBULA_CONFIG_FILE=./config.yaml

# ---- tests -----------------------------------------------------------------
# Integration tests are skipped unless this is set. They create and drop a
# database per test, so the role needs CREATEDB.
#NEBULA_TEST_DATABASE_URL=postgres://nebula:nebula@127.0.0.1:5432/nebula_test?sslmode=disable

# NEBULA configuration — copy to .env for local development.
#
# Precedence, lowest to highest: code defaults, config file, environment,
# command-line flags. Everything here has a default in code except the database
# URL, which is deliberately required: a service that silently connects to a
# default database is worse than one that refuses to start.
#
# .env is gitignored. Never commit real credentials.

# ---- environment -----------------------------------------------------------
# dev | staging | production.
# In production every NEBULA_DEV_* setting below becomes a startup FAILURE, text
# logs are refused, and a well-known database password is refused.
NEBULA_ENV=dev

# ---- database (required) ---------------------------------------------------
NEBULA_DATABASE_URL=postgres://nebula:nebula@127.0.0.1:5432/nebula?sslmode=disable

# Connection pool. Replica count times NEBULA_DATABASE_MAX_CONNS must stay below
# the server's max_connections; PgBouncer is the next step, not more replicas.
#NEBULA_DATABASE_MAX_CONNS=10
#NEBULA_DATABASE_MIN_CONNS=2
#NEBULA_DATABASE_MAX_CONN_LIFETIME=1h
#NEBULA_DATABASE_MAX_CONN_IDLE_TIME=30m
#NEBULA_DATABASE_CONNECT_TIMEOUT=10s

# Applied server-side to every session, so a runaway query cannot hold a
# connection indefinitely.
#NEBULA_DATABASE_STATEMENT_TIMEOUT=30s

# Refuse to serve when the schema is not the version this binary was built
# against. Leave this on.
#NEBULA_DATABASE_ASSERT_SCHEMA_VERSION=true

# ---- logging ---------------------------------------------------------------
#NEBULA_LOG_LEVEL=info          # debug | info | warn | error
#NEBULA_LOG_FORMAT=json         # json | text; text is development only
#NEBULA_LOG_ADD_SOURCE=false    # file:line on every line; noisy in production

# ---- HTTP ------------------------------------------------------------------
#NEBULA_HTTP_ADDR=:8082
#NEBULA_HTTP_READ_HEADER_TIMEOUT=10s
#NEBULA_HTTP_READ_TIMEOUT=30s
#NEBULA_HTTP_WRITE_TIMEOUT=60s
#NEBULA_HTTP_IDLE_TIMEOUT=120s

# Must be shorter than the pod's terminationGracePeriodSeconds.
#NEBULA_HTTP_SHUTDOWN_GRACE=25s

# Pause between failing readiness and refusing traffic, so EndpointSlice
# propagation completes first. This is the fix for 503s during a rolling deploy.
#NEBULA_HTTP_DRAIN_DELAY=5s

#NEBULA_HTTP_MAX_HEADER_BYTES=1048576
#NEBULA_HTTP_MAX_BODY_BYTES=10485760

# ---- development only ------------------------------------------------------
# Each of these is rejected at startup when NEBULA_ENV=production.
#NEBULA_DEV_SEED=false            # seed a development org, user and API key
#NEBULA_DEV_MOCK_RUNTIME=false    # allow the declared-stub inference runtime
#NEBULA_DEV_DEBUG_ENDPOINTS=false # expose /debug/pprof

# ---- config file -----------------------------------------------------------
# Optional YAML file; the environment overrides it, flags override both.
#NEBULA_CONFIG_FILE=./config.yaml

# ---- tests -----------------------------------------------------------------
# Integration tests are skipped unless this is set. They create and drop a
# database per test, so the role needs CREATEDB.
#NEBULA_TEST_DATABASE_URL=postgres://nebula:nebula@127.0.0.1:5432/nebula_test?sslmode=disable
